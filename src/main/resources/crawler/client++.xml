<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE components PUBLIC "-//DBFLUTE//DTD LastaDi 1.0//EN"
	"http://dbflute.org/meta/lastadi10.dtd">
<components namespace="fessCrawler">
	<include path="crawler/container.xml" />

	<!-- GcsClient is fess-crawler's, and stays there; only the SDK it needs moved into this plugin.
	     The client is registered through crawlerClientCreator rather than by adding it to
	     clientFactory, because a "++" file can add components but cannot append a postConstruct to
	     a component another file declares. fess-crawler-playwright registers playwrightClient the
	     same way. crawlerClientCreator.register() also reaches the factories that already exist,
	     so nothing depends on this running before the first crawl. -->
	<component name="gcsClient"
		class="org.codelibs.fess.crawler.client.gcs.GcsClient" instance="prototype">
		<property name="charset">"UTF-8"</property>
	</component>

	<component name="gcsClientCreator" class="org.codelibs.fess.storage.gcs.GcsClientCreator">
		<postConstruct name="register">
			<arg>"gcsClient"</arg>
		</postConstruct>
	</component>
</components>
